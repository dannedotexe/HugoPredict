# systemd-Dienst für den Dauerbetrieb (z. B. auf einer Oracle-Cloud-VM).
# Installation: siehe README → "Hosting auf Oracle Cloud".
[Unit]
Description=HugoSMP Market Discord-Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hugobot
WorkingDirectory=/opt/hugosmp-market-bot
ExecStart=/usr/bin/node src/index.js
Restart=on-failure
RestartSec=10
Environment=NODE_ENV=production
# Härtung
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/hugosmp-market-bot/data

[Install]
WantedBy=multi-user.target
