# --- Webserver ---
PORT=3000
# Kommagetrennte Minecraft-Namen, die Admin-Rechte bekommen
ADMIN_MC=Alpha_Noah
# true, wenn die Seite über HTTPS läuft
COOKIE_SECURE=false
DB_FILE=data/hugopredict.db

# --- Märkte ---
# Gebühr in Prozent auf jeden Kauf/Verkauf (geht an das Haus)
FEE_PERCENT=1
# Standard-Liquidität (LMSR b). Höher = Preise bewegen sich langsamer.
# Maximaler Verlust des Hauses pro Markt = b * ln(Anzahl Outcomes)
DEFAULT_LIQUIDITY=100
MIN_WITHDRAW=10

# --- Externer Minecraft-Bot (Discord-Bot-Repo, Branch claude/hugosmp-market-discord-kyruph) ---
# Gemeinsamer Schlüssel, mindestens 32 Zeichen. Beim Bot derselbe Wert in HUGO_API_KEY,
# dort HUGO_API_URL=https://<deine-domain>/api/bot. Gesetzt = der eingebaute Bot unten bleibt aus.
HUGO_API_KEY=
# Öffentliche Adresse der Website, wird im Discord verlinkt
WEBSITE_URL=

# --- Eingebauter Mineflayer Bot (nur ohne HUGO_API_KEY) ---
BOT_ENABLED=false
MC_HOST=play.hugosmp.net
MC_PORT=25565
MC_USERNAME=HugoPredict
# microsoft (Premium-Account) oder offline
MC_AUTH=microsoft
# leer lassen = automatisch erkennen
MC_VERSION=
# Optional: Befehl nach dem Join (z.B. "/server smp")
MC_JOIN_COMMAND=
# Befehl für Auszahlungen
PAY_COMMAND=/pay {player} {amount}
# Eigene Regex-Muster für Zahlungseingänge, getrennt mit ||
# Benötigt die Gruppen (?<player>...) und (?<amount>...) und sollte mit ^ beginnen.
# Leer = Standardmuster für EssentialsX & Co.
DEPOSIT_PATTERNS=
# true = alle Chatnachrichten im Log ausgeben (hilft beim Finden des richtigen Musters)
LOG_CHAT=false
