# ─── Discord (Pflicht) ────────────────────────────────────────────────
# Developer Portal → Bot → Reset Token. NIEMALS committen oder teilen.
DISCORD_TOKEN=
# Developer Portal → General Information → Application ID
DISCORD_CLIENT_ID=
# Rechtsklick auf deinen Server → "Server-ID kopieren" (Entwicklermodus aktivieren).
# Gesetzt = Slash-Commands werden sofort für diesen Server registriert.
DISCORD_GUILD_ID=

# ─── Website / HugoPredict-API (optional, aber für Wirtschaftsfunktionen nötig) ─
# Öffentliche Website, wird in Panels und Embeds verlinkt.
WEBSITE_URL=
# Basis-URL der Bot-API der Website (Vertrag: docs/API.md). Muss HTTPS sein.
HUGO_API_URL=
# Geheimer API-Schlüssel, wird als "Authorization: Bearer <key>" gesendet.
HUGO_API_KEY=
HUGO_API_TIMEOUT_MS=8000
# Angenommene Marktvorschläge per API auf der Website anlegen (POST /markets/proposals).
MARKET_CREATION_ENABLED=false

# ─── Minecraft-Bot auf HugoSMP (optional) ────────────────────────────
# Kontoverknüpfung per Code im Spiel, Einzahlungen per /pay, Auszahlungen.
MC_ENABLED=false
MC_HOST=
MC_PORT=25565
# Leer = Version automatisch erkennen, sonst z. B. 1.21.4
MC_VERSION=
# Microsoft-Konto (E-Mail) des Bot-Accounts. Beim ersten Start erscheint in
# #systemmeldungen ein Anmeldecode für microsoft.com/link.
MC_ACCOUNT=
# Befehle nach dem Betreten, durch ; getrennt (z. B. /server smp)
MC_JOIN_COMMANDS=
MC_WHISPER_COMMAND=/msg {name} {text}
MC_PAY_COMMAND=/pay {name} {amount}
# Falls /pay eine Bestätigung verlangt, z. B. /pay confirm
MC_PAY_CONFIRM_COMMAND=
MC_BALANCE_COMMAND=/balance
# Einzahlungen erst nach gestiegenem Kontostand gutschreiben (empfohlen).
# false = jede erkannte Zahlungsnachricht zählt sofort. Auszahlungen prüft der Bot immer.
MC_BALANCE_CHECK=false
# Eigene Erkennung (regulärer Ausdruck), falls die Standardmuster nicht passen.
# Zahlung braucht (?<amount>…) und (?<name>…), Kontostand braucht (?<amount>…).
MC_PAY_PATTERN=
MC_BALANCE_PATTERN=
# Flüstern, falls der Server ein eigenes Format hat. Muss mit ^ beginnen und (?<name>…) und (?<message>…) haben.
MC_WHISPER_PATTERN=
# Auszahlungen erst einschalten, wenn die Website sie freigibt (docs/API.md).
MC_PAYOUTS_ENABLED=false
# Höchstbetrag pro Auszahlung in Spielgeld (Pflicht bei Auszahlungen)
MC_PAYOUT_MAX=0
MC_PAYOUT_INTERVAL_SECONDS=30

# ─── Darstellung & Marktübersicht ────────────────────────────────────
# Name in Embeds und Texten
BRAND_NAME=HugoPredict
CURRENCY_NAME=HugoCoins
# Abfrageintervall der Website für #marktübersicht
MARKET_FEED_INTERVAL_SECONDS=60
# Höchstzahl aktiver Märkte mit eigener Nachricht in #marktübersicht
MARKET_FEED_MAX_MARKETS=25

# ─── Kundenservice ──────────────────────────────────────────────────
TICKET_CLOSE_CONFIRMATION=true
MAX_OPEN_TICKETS_PER_USER=2

# ─── Betrieb ─────────────────────────────────────────────────────────
# Speicherort für gespeicherte Channel-/Rollen-IDs, Panels und Tickets.
DATA_DIR=./data
# debug | info | warn | error
LOG_LEVEL=info

# ─── Admin-Panel (/panel) ────────────────────────────────────────────
# Discord-IDs, die /panel benutzen dürfen (kommagetrennt)
PANEL_ADMIN_IDS=1489628580123250870
