+test('Website-Code per Flüstern: nur gültige Form, Antwort an den Spieler', async (t) => {
+  const { world, api, mc } = setup();
+  t.after(() => mc.stop());
+  const seen = [];
+  api.linkWebsiteAccount = async (l) => { seen.push(l); return { username: 'steve', claimed: 100 }; };
+  mc.start();
+  await until(() => mc.state.online);
+  const bot = world.bots[0];
+  bot.emit('whisper', 'Steve', 'hallo');
+  bot.emit('whisper', 'Steve', 'verify a1b2c3');
