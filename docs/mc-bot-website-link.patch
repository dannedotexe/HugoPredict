+  /** Ein Spieler hat dem Bot im Spiel den Code aus seiner Website-Wallet geflüstert. */
+  async linkWebsiteAccount({ minecraftName, minecraftUuid, code }) {
+    const body = await this.request('POST', '/minecraft/website-links', { body: { minecraftName, minecraftUuid, code } });
+    if (!isObj(body) || body.linked !== true) throw new ApiError('invalid_response', 'Verknüpfung ohne linked === true.', { body });
+    return { username: typeof body.username === 'string' ? body.username : null, claimed: isNum(body.claimed) ? body.claimed : 0 };
+  }
+
+  /** Zeigt auf der Website, ob der Minecraft-Bot gerade auf dem Server ist. */
+  async minecraftHeartbeat({ online, username }) {
+    await this.request('POST', '/minecraft/heartbeat', { body: { online, username } });
+  }
+
